// The public functions over the default engine: `cn` with its argument-identity cache and
// sequence prediction (upstream's `wrapClsx`), `twMerge`, `clsx` and `twJoin`. The cache is
// module state for the same reason the engine is (finer 048). The `cn` fast paths read the
// call's arguments by index only; the arguments object is never passed whole, so a predicted
// call allocates nothing — the array for the resolve path exists only on a miss.
import { mergeString, mergeUncached, seenBefore, resolveValue } from "./engine.lil";


export extern class ArgumentEntry {
  string r;
  int t;
  string a0;
  string a1;
  string a2;
  string[] a;
  // The entry that followed this one last time. Typed, as upstream types it: a `JsValue` here
  // makes every prediction hop a truthiness test and a `JS.assume`, where the original does one
  // `!== null` (finer 049).
  ArgumentEntry? n;
}

ArgumentEntry makeArgumentEntry(string result, string[] values) {
  string second = "";
  if (values.length > 1) second = values[1];
  string third = "";
  if (values.length > 2) third = values[2];
  return JS.assume(JS.object("r", result, "t", values.length, "a0", values[0], "a1", second, "a2", third, "a", values, "n", null));
}

void dropFirstArgumentEntry(ArgumentEntry[] values) {
  int index = 1;
  while (index < values.length) {
    values[index - 1] = values[index];
    index = index + 1;
  }
  values.pop();
}

Map<string, ArgumentEntry[]> argumentCache = new Map<string, ArgumentEntry[]>();
Map<string, ArgumentEntry[]> previousArgumentCache = new Map<string, ArgumentEntry[]>();
int argumentCount = 0;
ArgumentEntry? lastHit = null;

// unrolled truthy-sequence verify for arity <= 3 against the entry's monomorphic fields
bool matchThree(ArgumentEntry entry, JsValue valueZero, JsValue valueOne, JsValue valueTwo) {
  float index = 0.0;
  if (valueZero.truthy()) {
    if (!JS.strictEqual(valueZero, entry.a0)) return false;
    index = 1.0;
  }
  if (valueOne.truthy()) {
    string expected = entry.a1;
    if (index == 0.0) expected = entry.a0;
    if (!JS.strictEqual(valueOne, expected)) return false;
    index = index + 1;
  }
  if (valueTwo.truthy()) {
    string expected = entry.a0;
    if (index == 1.0) expected = entry.a1;
    else if (index == 2.0) expected = entry.a2;
    if (!JS.strictEqual(valueTwo, expected)) return false;
    index = index + 1;
  }
  return index == entry.t;
}

// loop-form verify over resolved values (identity compares; non-strings never match).
// The entry's array is read once: a member read inside the comparison loop is one property
// load per compared argument, and the compiler has no loop-invariant motion (finer 048).
bool matchValues(ArgumentEntry entry, JsValue[] values) {
  string[] entryValues = entry.a;
  int entryIndex = 0;
  int index = 0;
  int length = values.length;
  while (index < length) {
    JsValue value = values[index];
    if (value.truthy()) {
      if (!JS.strictEqual(value, entryValues[entryIndex])) return false;
      entryIndex = entryIndex + 1;
    }
    index = index + 1;
  }
  return entryIndex == entry.t;
}

string resolveArguments(JsValue[] values, bool alreadyProbed) {
  int argumentLength = values.length;
  ArgumentEntry? prior = lastHit;
  ArgumentEntry? prediction = null;
  if (prior != null) prediction = prior.n;
  if (!alreadyProbed) {
    if (prediction != null && matchValues(prediction, values)) {
      lastHit = prediction;
      return prediction.r;
    }
    if (prior != null && prior != prediction && matchValues(prior, values)) return prior.r;
  }
  string first = "";
  int firstIndex = -1;
  int truthy = 0;
  bool resolvedAValue = false;
  int index = 0;
  while (index < argumentLength) {
    JsValue value = values[index];
    if (value.truthy()) {
      // Both arms hand the loop a `string`, so recording the first one is an assignment and
      // not a coercion: `JS.string(value)` on a JsValue emits `value+""` even where the guard
      // has already proven it a string, and this runs on every call (finer 049).
      string text = "";
      if (value is string) text = value;
      else {
        // objects and arrays resolve in place and ride the string path
        text = resolveValue(value, true);
        values[index] = text;
        if (text == "") {
          index = index + 1;
          continue;
        }
        resolvedAValue = true;
      }
      if (firstIndex < 0) {
        first = text;
        firstIndex = index;
      }
      truthy = truthy + 1;
    }
    index = index + 1;
  }
  if (truthy == 0) return "";
  if (truthy == 1) return mergeString(first);
  if (resolvedAValue) {
    if (prediction != null && matchValues(prediction, values)) {
      lastHit = prediction;
      return prediction.r;
    }
    if (prior != null && prior != prediction && matchValues(prior, values)) return prior.r;
  }
  ArgumentEntry[]? maybeBucket = argumentCache.get(first);
  if (maybeBucket == null) {
    maybeBucket = previousArgumentCache.get(first);
    if (maybeBucket != null) argumentCache.set(first, maybeBucket);
  }
  // The walk runs only when the bucket exists, so a hit costs no allocation; the entry's
  // values are read once per candidate rather than once per compared argument.
  ArgumentEntry? hit = null;
  if (maybeBucket != null) {
    ArgumentEntry[] bucket = maybeBucket;
    int bucketIndex = 0;
    while (bucketIndex < bucket.length) {
      ArgumentEntry candidate = bucket[bucketIndex];
      if (candidate.t == truthy) {
        string[] entryValues = candidate.a;
        int valueIndex = 1;
        bool matches = true;
        index = firstIndex + 1;
        while (index < argumentLength) {
          JsValue value = values[index];
          if (value.truthy()) {
            if (!JS.strictEqual(value, entryValues[valueIndex])) {
              matches = false;
              break;
            }
            valueIndex = valueIndex + 1;
          }
          index = index + 1;
        }
        if (matches) {
          hit = candidate;
          break;
        }
      }
      bucketIndex = bucketIndex + 1;
    }
  }
  if (hit == null) {
    string joined = first;
    string[] strings = [first];
    index = firstIndex + 1;
    while (index < argumentLength) {
      JsValue value = values[index];
      if (value.truthy()) {
        string text = JS.string(value);
        joined = joined + " " + text;
        strings.push(text);
      }
      index = index + 1;
    }
    // a first sighting is merged straight through: no dictionary lookup on a fresh key, no
    // cache entry anywhere, chain left untouched
    if (!seenBefore(joined)) return mergeUncached(joined);
    ArgumentEntry created = makeArgumentEntry(mergeString(joined), strings);
    hit = created;
    ArgumentEntry[] bucket = [];
    if (maybeBucket != null) bucket = maybeBucket;
    else argumentCache.set(first, bucket);
    if (bucket.length >= 256) dropFirstArgumentEntry(bucket);
    bucket.push(created);
    argumentCount = argumentCount + 1;
    if (argumentCount > 1000) {
      argumentCount = 0;
      previousArgumentCache = argumentCache;
      argumentCache = new Map<string, ArgumentEntry[]>();
    }
  }
  if (hit == null) throw JS.construct(Error, "cn: argument cache invariant");
  ArgumentEntry actualHit = hit;
  prior = lastHit;
  if (prior != null && prior != actualHit) prior.n = actualHit;
  lastHit = actualHit;
  return actualHit.r;
}

string joinArguments(JsValue argumentsValue, bool clsxMode) {
  string output = "";
  int length = argumentsValue.length.toInt();
  int index = 0;
  while (index < length) {
    JsValue argument = argumentsValue[index];
    if (argument.truthy()) {
      string resolved = "";
      if (argument is string) resolved = argument;
      else resolved = resolveValue(argument, clsxMode);
      if (resolved != "") {
        if (output != "") output = output + " ";
        output = output + resolved;
      }
    }
    index = index + 1;
  }
  return output;
}

export JsValue cn = JS.staticRest((JsValue args) => {
  int length = args.length.toInt();
  if ((length | 1) == 3) {
    // arity 2 or 3: sequence prediction, then the self-repeat probe, all by identity
    JsValue valueZero = args[0];
    JsValue valueOne = args[1];
    JsValue valueTwo = args[2];
    ArgumentEntry? last = lastHit;
    if (last != null) {
      ArgumentEntry? prediction = last.n;
      if (prediction != null && matchThree(prediction, valueZero, valueOne, valueTwo)) {
        lastHit = prediction;
        return prediction.r;
      }
      // `!=` on two references lowers to loose equality, which V8 runs through the abstract
      // comparison instead of a pointer compare; measured 1.11 against 1.03 on component:single.
      // `last` is non-null here, so strict is the same question (finer 052).
      if (!JS.strictEqual(last, prediction) && matchThree(last, valueZero, valueOne, valueTwo)) return last.r;
    }
    JsValue[] values = [valueZero, valueOne, valueTwo];
    return resolveArguments(values, true);
  }
  if (length == 1) {
    JsValue only = args[0];
    if (only is string) return mergeString(only);
    return mergeString(resolveValue(only, true));
  }
  // 4+ arity: probe predictions in place over the arguments (indexed reads only); only a
  // genuine miss copies into an array for the resolve path
  ArgumentEntry? last = lastHit;
  if (last != null) {
    ArgumentEntry? prediction = last.n;
    if (prediction != null) {
      int entryIndex = 0;
      int index = 0;
      bool matches = true;
      while (index < length) {
        JsValue value = args[index];
        if (value.truthy()) {
          if (!JS.strictEqual(value, prediction.a[entryIndex])) {
            matches = false;
            break;
          }
          entryIndex = entryIndex + 1;
        }
        index = index + 1;
      }
      if (matches && entryIndex == prediction.t) {
        lastHit = prediction;
        return prediction.r;
      }
    }
    if (!JS.strictEqual(last, prediction)) {
      int entryIndex = 0;
      int index = 0;
      bool matches = true;
      while (index < length) {
        JsValue value = args[index];
        if (value.truthy()) {
          if (!JS.strictEqual(value, last.a[entryIndex])) {
            matches = false;
            break;
          }
          entryIndex = entryIndex + 1;
        }
        index = index + 1;
      }
      if (matches && entryIndex == last.t) return last.r;
    }
  }
  JsValue[] values = [];
  int index = 0;
  while (index < length) {
    values.push(args[index]);
    index = index + 1;
  }
  return resolveArguments(values, true);
});

export JsValue twMerge = JS.staticRest((JsValue args) => {
  if (args.length == 1.0) {
    JsValue only = args[0];
    if (only is string) return mergeString(only);
  }
  string joined = "";
  int index = 0;
  int length = args.length.toInt();
  while (index < length) {
    JsValue value = args[index];
    if (value.truthy()) {
      string resolved = "";
      if (value is string) resolved = value;
      else resolved = resolveValue(value, false);
      if (resolved != "") {
        if (joined != "") joined = joined + " ";
        joined = joined + resolved;
      }
    }
    index = index + 1;
  }
  return mergeString(joined);
});

export JsValue clsx = JS.staticRest((JsValue args) => {
  return joinArguments(args, true);
});

export JsValue twJoin = JS.staticRest((JsValue args) => {
  return joinArguments(args, false);
});
